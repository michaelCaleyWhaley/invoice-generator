{
  "name": "invoice-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite dev & electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "main": "electron-main.cjs",
  "devDependencies": {
    "vite": "^8.2.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "electron": "^26.2.0",
    "electron-builder": "^24.7.0"
  },
  "dependencies": {
    "blob-stream": "^0.1.3",
    "pdfkit": "^0.19.1",
    "svg-to-pdfkit": "^0.1.8"
  }
  ,
  "build": {
    "appId": "com.example.invoice-generator",
